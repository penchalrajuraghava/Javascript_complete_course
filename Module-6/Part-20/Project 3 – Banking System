class BankAccount {

    #balance;

    constructor(name, balance) {

        this.name = name;
        this.#balance = balance;

    }

    deposit(amount) {

        this.#balance += amount;

    }

    withdraw(amount) {

        this.#balance -= amount;

    }

    getBalance() {

        return this.#balance;

    }

}

const account = new BankAccount("Sunny", 1000);

account.deposit(500);

console.log(account.getBalance());